NUXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api

# Dominio de la plataforma, sin tienda. El catálogo saca el slug del
# subdominio que sobra: rex.lvh.me:3000 → "rex".
# En producción: miotienda.com
NUXT_PUBLIC_BASE_DOMAIN=lvh.me:3000

# Puerto del panel en desarrollo, donde corre aparte del catálogo. Lo usa
# el botón "Mi panel". En producción va vacío: comparten origen.
NUXT_PUBLIC_PANEL_PORT=5173
