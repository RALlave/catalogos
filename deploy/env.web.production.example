# =============================================================================
#  web/.env  —  producción (catálogo público, Nuxt)
#  Copiar a web/.env en el VPS ANTES de correr "npm run build".
# =============================================================================

NUXT_PUBLIC_API_BASE=https://api.miotienda.com/api

# Dominio de la plataforma, sin tienda: el catálogo saca el slug del
# subdominio que sobra en el host (rex.miotienda.com → "rex").
NUXT_PUBLIC_BASE_DOMAIN=miotienda.com
