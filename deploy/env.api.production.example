# =============================================================================
#  api/.env  —  producción
#  Copiar a api/.env en el VPS y completar lo que está vacío.
# =============================================================================

APP_NAME=Catalogos
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# De esto dependen los enlaces de las imágenes: tiene que incluir /api,
# porque Laravel vive bajo ese prefijo.
APP_URL=https://diseprog.com/api

# A dónde apuntan los enlaces del correo de "recuperar contraseña".
FRONTEND_URL=https://diseprog.com/panel

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=base_catalogos
DB_USERNAME=catalogos
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=public

# Correo real: sin esto, "recuperar contraseña" no envía nada.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=no-responder@diseprog.com
MAIL_FROM_NAME="${APP_NAME}"

# El superadmin se crea con "php artisan superadmin:create", no acá.
SUPERADMIN_NAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
