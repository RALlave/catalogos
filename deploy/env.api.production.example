# =============================================================================
#  api/.env  —  producción
#  Copiar a api/.env en el VPS y completar lo que está vacío.
# =============================================================================

APP_NAME=Catalogos
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# De esto dependen los enlaces de las imágenes: el disco público arma sus URLs
# como APP_URL + /storage. Va el subdominio pelado y SIN el prefijo /api: las
# rutas de la API cuelgan de ahí (api.miotienda.com/api/...), pero las imágenes
# no (api.miotienda.com/storage/...). Con /api al final no carga ninguna foto.
APP_URL=https://api.miotienda.com

# Dominio pelado de la plataforma, SIN tienda y SIN ruta. Se usa para dos
# cosas: armar la dirección del catálogo de cada tienda como subdominio
# (rex.miotienda.com) y como destino del correo de "recuperar contraseña",
# que siempre cae en el dominio principal. De acá sale también el patrón
# de CORS, así que si está mal, el panel deja de poder hablar con la API.
FRONTEND_URL=https://miotienda.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=catalogos
DB_USERNAME=catalogos
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=public

# Correo real: sin esto, "recuperar contraseña" no envía nada.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=no-responder@miotienda.com
MAIL_FROM_NAME="${APP_NAME}"

# El superadmin se crea con "php artisan superadmin:create", no acá.
SUPERADMIN_NAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
