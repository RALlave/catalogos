# =============================================================================
#  panel/.env  —  producción (panel de tienda y superadmin, Vue)
#  Copiar a panel/.env en el VPS ANTES de correr "npm run build".
#
#  VITE_BASE es lo que hace que el panel funcione colgado de /panel/.
#  Si falta, la SPA compila para la raíz y no carga ni un archivo.
# =============================================================================

VITE_API_BASE=https://diseprog.com/api
VITE_BASE=/panel/
