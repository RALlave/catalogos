# =============================================================================
#  panel/.env  —  producción (panel de tienda y superadmin, Vue)
#  Copiar a panel/.env en el VPS ANTES de correr "npm run build".
#
#  VITE_BASE es de dónde cuelgan los ARCHIVOS del panel, no sus rutas: las
#  rutas (/login, /admin, /superadmin) viven en la raíz, conviviendo con el
#  catálogo. Si falta, los assets se piden a la raíz y Nuxt responde el
#  catálogo en vez del JavaScript: la SPA queda en blanco.
# =============================================================================

VITE_API_BASE=https://api.miotienda.com/api
VITE_BASE=/panel/

# Dominio de la plataforma, sin tienda: con esto el panel sabe en qué
# subdominio está y a cuál saltar.
VITE_BASE_DOMAIN=miotienda.com
